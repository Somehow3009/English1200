# Copy thành .env rồi điền key. KHÔNG commit .env lên git.
# Key Gemini CHUNG của chủ web (dự phòng khi user chưa thêm key riêng).
# User nào thêm key riêng thì AI dùng key + quota của chính người đó.
GEMINI_KEY=

# Chìa khóa mã hóa key của user (bắt buộc 64 ký tự hex khi public thật).
# Tạo bằng: .tools/node/node.exe -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Ai có chuỗi này mới giải được key user — giữ tuyệt mật như mật khẩu.
MASTER_SECRET=

# Cổng chạy (mặc định 3000)
PORT=3000

# Đường dẫn file SQLite (mặc định server/app.db)
# DB_PATH=/data/app.db

# Đặt =1 khi deploy HTTPS để cookie thêm cờ Secure
# COOKIE_SECURE=1
