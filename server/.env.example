# Copy thành .env rồi điền. KHÔNG commit .env lên git.
# Database Postgres (Supabase → Project Settings → Database → Connection string → URI).
# Nên dùng cổng pooled 6543, giữ nguyên ?sslmode=require ở cuối.
# Ví dụ: postgresql://postgres.xyz:PASS@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres?sslmode=require
DATABASE_URL=
# Username admin (giáo viên), cách nhau bằng dấu phẩy. Ví dụ: ADMIN_USERNAMES=minh,hoa
ADMIN_USERNAMES=

# Key Gemini CHUNG của chủ web (dự phòng khi user chưa thêm key riêng).
# User nào thêm key riêng thì AI dùng key + quota của chính người đó.
GEMINI_KEY=

# Chìa khóa mã hóa key của user (bắt buộc 64 ký tự hex khi public thật).
# Tạo bằng: .tools/node/node.exe -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Ai có chuỗi này mới giải được key user — giữ tuyệt mật như mật khẩu.
MASTER_SECRET=

# Cổng chạy (mặc định 3000)
PORT=3000

# Bỏ comment khi chạy local mà Supabase chặn SSL (không nên trên production)
# DATABASE_URL=postgresql://postgres:PASS@localhost:5432/eng?sslmode=disable

# Đặt =1 khi deploy HTTPS để cookie thêm cờ Secure
# COOKIE_SECURE=1
